{
  "name": "@flowguard/server",
  "version": "0.1.0",
  "description": "FlowGuard BFF — business event ingress, Temporal orchestration client, decision log",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "seed": "nest build && node dist/seed"
  },
  "dependencies": {
