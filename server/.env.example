# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── MongoDB Atlas ──────────────────────────────────────────────────────
# Use a non-Middle-East region (see D9). Frankfurt eu-central-1 recommended.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_DB_NAME=flowguard

# ── Temporal ───────────────────────────────────────────────────────────
# Local dev:  temporal server start-dev --db-filename temporal.db
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=flowguard
# Temporal Cloud only — leave blank for local dev
TEMPORAL_API_KEY=
TEMPORAL_TLS=false

# ── Nokia Network as Code ──────────────────────────────────────────────
# Shared secret Nokia echoes back on webhook callbacks (notificationAuthToken)
NOKIA_WEBHOOK_TOKEN=change-me-nokia-webhook-token

# ── Internal ───────────────────────────────────────────────────────────
# Bearer token the Python activities use to POST /internal/decisions
INTERNAL_API_TOKEN=change-me-internal-token

# Signs the session cookie. At least 32 characters; the server refuses to boot
# with anything shorter. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
