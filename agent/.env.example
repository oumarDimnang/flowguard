# ── Temporal ───────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=flowguard

# ── FlowGuard server (where decision events are posted) ────────────────
SERVER_BASE_URL=http://localhost:3000
INTERNAL_API_TOKEN=change-me-internal-token

# ── Network provider: "mock" runs fully offline, "nokia" hits the sandbox
NETWORK_PROVIDER=mock
NOKIA_API_KEY=
# Regional API hub host — note the 'p-eu'. Differs by region.
NOKIA_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io
NOKIA_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
# Verified against the sandbox playground. NOT 'QOS_L' — that is the
# TypeScript SDK's name and this API rejects it.
NOKIA_QOS_PROFILE=DOWNLINK_M_UPLINK_L
# The QoD 'applicationServer' — the far end of the protected flow.
NOKIA_APPLICATION_SERVER_IPV4=8.8.8.8
NOKIA_SLICE_ID=
# Public HTTPS base for CAMARA callbacks (ngrok during development)
WEBHOOK_BASE_URL=
NOKIA_WEBHOOK_TOKEN=change-me-nokia-webhook-token

# ── LLM: "mock" runs fully offline, "openrouter" calls a real model ────
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-5.6-luna
LLM_FALLBACK_MODELS=openai/gpt-5.6-terra
LLM_CONFIDENCE_THRESHOLD=0.80

# ── Observability (optional) ──────────────────────────────────────────
# One Langfuse trace per Temporal workflow run; one span per activity.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Decision policy (D1) — flip these live during Q&A ─────────────────
POLICY_ALWAYS_PROTECT_SAFETY_CRITICAL=false
POLICY_FAIL_OPEN=true
